#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/env.sh"

echo "Script Directory: $SCRIPT_DIR"
if [ -z "$1" ]; then
    echo 
    echo "No file provided. Logging a TODO item instead."
    # Example: append a TODO entry to a log file
    echo "TODO: Add issue details  $(cat $SCRIPT_DIR/todo.log) "
    exit 0
fi

# Commit and sync todo.log to a GitHub Gist using GitHub CLI (gh)
if [ ! -f "$SCRIPT_DIR/todo.log" ]; then
    echo "No todo.log found to sync."
    exit 1
fi

# Try to auto-detect GitHub repo from current git directory
if [[ -d .git || $(git rev-parse --is-inside-work-tree 2>/dev/null) == "true" ]]; then
    REMOTE_URL=$(git config --get remote.origin.url)
    
    # Extract the user/repo format
    if [[ "$REMOTE_URL" =~ github.com[:/](.*)\.git ]]; then
        GITHUB_REPO="${BASH_REMATCH[1]}"
    fi
fi

# Try to detect GitHub repo
if [[ -z "$GITHUB_REPO" ]]; then
    if [[ -d .git || $(git rev-parse --is-inside-work-tree 2>/dev/null) == "true" ]]; then
        REMOTE_URL=$(git config --get remote.origin.url)
        if [[ "$REMOTE_URL" =~ github.com[:/](.*)\.git ]]; then
            GITHUB_REPO="${BASH_REMATCH[1]}"
        fi
    fi
fi

# Sync to GitHub if both token and repo are available
# if [[ -n "$GITHUB_TOKEN" && -n "$GITHUB_REPO" ]]; then


# pattern parsing for lable and body file
PRIORITY="normal"
BODY_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--priority)
            PRIORITY="$2"
            echo "Priority set to: $PRIORITY"
            shift 2
        ;;
        -f|--file)
            BODY_FILE="$2"
            echo "Body file set to: $BODY_FILE"
            shift 2
        ;;
        -l|--label)
            LABEL="$2"
            echo "Label set to: $LABEL"
            shift 2
        ;;
        -b|--body)
            BODY="$2"
            if [ -f $BODY ]; then
                BODY=$(<"$BODY")
            else
                echo "Warning: Body file '$BODY' does not exist. Using as plain text."
            fi
            echo "Body set to: $BODY"
            shift 2
        ;;
        *)
            # First non-flag argument is the issue title
            if [[ -z "$TITLE" ]]; then
                TITLE="$1"
                echo "Issue title set to: $TITLE"
            fi
            shift
        ;;
    esac
done
GITHUB_USER=$(echo "$GITHUB_REPO" | cut -d'/' -f1)
GITHUB_REPO_NAME=$(echo "$GITHUB_REPO" | cut -d'/' -f2) 

# BODY=$(<bug_report.md)

echo "Issue created successfully."
echo "GITHUB_REPO: $GITHUB_REPO"
echo "GitHub user: $GITHUB_USER"
echo "GitHub repo: $GITHUB_REPO_NAME"

